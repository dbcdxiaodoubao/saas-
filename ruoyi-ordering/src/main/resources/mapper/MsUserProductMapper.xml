<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mashang.ordering.mapper.MsUserProductMapper">

    <resultMap id="ProductResultMap" type="com.mashang.ordering.domain.vo.MsUserProductListVo">
        <id column="product_id" property="productId"/>
        <result column="product_categories_id" property="productCategoriesId"/>
        <result column="product_name" property="productName"/>
        <result column="product_price" property="productPrice"/>
        <result column="product_cover" property="productCover"/>
        <result column="product_introduction" property="productIntroduction"/>
        <!-- JSON 字段映射 -->
        <result column="jsonful_price" property="jsonfulPrice" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
    </resultMap>


    <select id="getList" resultMap="ProductResultMap">
        SELECT
        p.product_id,
        p.product_categories_id,
        p.product_name,
        p.product_price,
        p.product_cover,
        p.product_introduction,
        s.jsonful_price
        FROM
        ms_product p
        INNER JOIN ms_specification s
        ON p.specification_id = s.specification_id
        <where>
            <!-- 只查询启用的商品 -->
            p.status = 0

            <!-- 分类ID筛选 -->
            <if test="productCategoriesId != null">
                AND p.product_categories_id = #{productCategoriesId}
            </if>

            <!-- 关键词搜索 -->
            <if test="keyWord != null and keyWord != ''">
                AND (
                p.keyword = #{keyWord}
                OR p.product_name LIKE concat('%', #{keyWord}, '%')
                )
            </if>
        </where>
    </select>

    <resultMap id="UserProductDtlResultMap" type="com.mashang.ordering.domain.vo.MsUserProductDtlVo">
        <id column="product_id" property="productId"/>
        <result column="categories_name" property="categoriesName"/>
        <result column="product_name" property="productName"/>
        <result column="product_price" property="productPrice"/>
        <result column="product_cover" property="productCover"/>
        <result column="product_carousel" property="productCarousel"/>
        <result column="product_introduction" property="productIntroduction"/>
        <result column="product_description" property="productDescription"/>
        <result column="earn_points" property="earnPoints"/>

        <!-- JSON 自动映射成 List<SpecificationType> -->
        <result column="jsonful_price" property="jsonfulPrice" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
    </resultMap>

    <select id="getDtl" resultMap="UserProductDtlResultMap">
        SELECT
            p.product_id,
            c.categories_name,
            p.product_name,
            p.product_price,
            p.product_cover,
            p.product_carousel,
            p.product_introduction,
            p.product_description,
            p.earn_points,
            s.jsonful_price
        FROM ms_product p
                 INNER JOIN ms_specification s
                            ON p.specification_id = s.specification_id
                 INNER JOIN ms_categories c
                            ON p.product_categories_id = c.categories_id
        WHERE
            p.product_id = #{id}
          AND p.del_flag = 0
          AND p.status = 0
    </select>
</mapper>