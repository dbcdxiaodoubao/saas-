<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mashang.ordering.mapper.MsUserOrderMapper">

    <select id="getList" resultMap="UserOrderResultMap">
        SELECT
            mo.order_id,
            mo.table_id,
            mo.order_number,
            mo.order_type,
            mo.order_status,
            mo.pay_time,
            mo.points_deduction,
            mo.actual_pay,
            mo.buy_type,
            mo.reserve_pick_time,
            mo.product_total_price,
            mo.diners_number,
            mo.create_time,
            mo.update_time,
            mo.remark,
            -- 子查询精准统计商品数量
            (SELECT COUNT(*) FROM ms_order_detail od WHERE od.order_id = mo.order_id) AS product_num
        FROM
            ms_order mo
        WHERE
            mo.user_id = #{userId}
          AND mo.del_flag = 0
        ORDER BY
            mo.create_time DESC
    </select>

    <!-- 2. 查询商品列表（供collection调用） -->
    <select id="selectProductByOrderId" resultType="com.mashang.ordering.domain.vo.MsUserOrderProduct">
        SELECT
            mp.product_id,
            mp.product_cover
        FROM ms_order_detail od
                 JOIN ms_product mp ON od.product_id = mp.product_id
        WHERE od.order_id = #{orderId}
    </select>

    <!-- 3. 结果映射（一对多，支持多个商品） -->
    <resultMap id="UserOrderResultMap" type="com.mashang.ordering.domain.vo.MsUserOrderListVo">
        <id column="order_id" property="orderId"/>
        <result column="order_number" property="orderNumber"/>
        <result column="order_type" property="orderType"/>
        <result column="order_status" property="orderStatus"/>
        <result column="pay_time" property="payTime"/>
        <result column="actual_pay" property="actualPay"/>
        <result column="product_total_price" property="productTotalPrice"/>
        <result column="diners_number" property="dinersNumber"/>
        <result column="create_time" property="createTime"/>
        <result column="product_num" property="productNum"/>

        <!-- 关键：一对多 嵌套查询，支持多个商品！！ -->
        <collection
                property="productList"
                javaType="ArrayList"
                ofType="com.mashang.ordering.domain.vo.MsUserOrderProduct"
                select="selectProductByOrderId"
                column="order_id">
        </collection>
    </resultMap>


    <select id="getDtl" resultMap="OrderDetailResultMap">
        SELECT
            mo.order_id,
            mo.user_id,
            mo.table_id,
            mo.order_number,
            mo.order_type,
            mo.order_status,
            mo.pay_time,
            mo.points_deduction,
            mo.actual_pay,
            mo.buy_type,
            mo.reserve_pick_time,
            mo.product_total_price,
            mo.diners_number,
            mo.finish_time,
            mo.create_time,
            mo.remark
        FROM ms_order mo
        WHERE mo.order_id = #{orderId}
          AND mo.del_flag != 1
    </select>

    <!-- 根据订单ID 查询商品详情列表 -->
    <select id="getProductListByOrderId" resultType="com.mashang.ordering.domain.vo.MsUserOrderProductDtl">
        SELECT
            mp.product_id,
            mp.product_name,
            od.product_quantity,
            od.specification,
            mp.product_price,
            od.cumulative_add_count,
            mp.product_cover
        FROM ms_order_detail od
                 JOIN ms_product mp ON od.product_id = mp.product_id
        WHERE od.order_id = #{orderId}
    </select>

    <!-- 结果映射：订单详情 + 多商品集合 -->
    <resultMap id="OrderDetailResultMap" type="com.mashang.ordering.domain.vo.MsUserOrderDtlVo">
        <id column="order_id" property="orderId"/>
        <result column="user_id" property="userId"/>
        <result column="table_id" property="tableId"/>
        <result column="order_number" property="orderNumber"/>
        <result column="order_type" property="orderType"/>
        <result column="order_status" property="orderStatus"/>
        <result column="pay_time" property="payTime"/>
        <result column="points_deduction" property="pointsDeduction"/>
        <result column="actual_pay" property="actualPay"/>
        <result column="buy_type" property="buyType"/>
        <result column="reserve_pick_time" property="reservePickTime"/>
        <result column="product_total_price" property="productTotalPrice"/>
        <result column="diners_number" property="dinersNumber"/>
        <result column="finish_time" property="finishTime"/>
        <result column="create_time" property="createTime"/>
        <result column="remark" property="remark"/>

        <!-- 一对多：自动装入多个商品 -->
        <collection
                property="userOderProductDtlList"
                javaType="ArrayList"
                ofType="com.mashang.ordering.domain.vo.MsUserOrderProductDtl"
                select="getProductListByOrderId"
                column="order_id"/>
    </resultMap>

    <insert id="insertOrder" parameterType="com.mashang.ordering.domain.param.create.MsUserOrderCreate">
        INSERT INTO ms_order (
            order_id,
            user_id,
            table_id,
            order_number,
            order_type,
            order_status,
            points_deduction,
            actual_pay,
            buy_type,
            product_total_price,
            diners_number,
            create_time,
            remark,
            del_flag
        ) VALUES (
                     #{orderId},
                     #{userId},
                     #{tableId},
                     #{orderNumber},
                     #{orderType},
                     '0',
                     #{pointsDeduction},
                     '0',
                     '0',
                     #{productTotalPrice},
                     #{dinersNumber},
                     NOW(),
                     #{remark},
                     '0'
                 )
    </insert>

    <insert id="batchInsertOrderDetail">
        INSERT INTO ms_order_detail (
        order_id,
        product_id,
        product_name,
        product_quantity,
        specification,
        product_price,
        cumulative_add_count,
        total_amount
        ) VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{orderId},
            #{item.productId},
            #{item.productName},
            #{item.productQuantity},
            #{item.specification},
            #{item.productPrice},
            #{item.cumulativeAddCount},
            #{item.productPrice} * #{item.productQuantity}
            )
        </foreach>
    </insert>


</mapper>